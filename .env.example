# Password for the web UI (min 12 chars recommended)
ACCESS_PASSWORD=changeme

# Neko internal passwords — separate from ACCESS_PASSWORD
NEKO_PASSWORD=changeme
NEKO_PASSWORD_ADMIN=changeme_admin

# Cloudflare Tunnel token — get this from Zero Trust → Tunnels
# Leave blank if you are not using the tunnel profile
CLOUDFLARE_TUNNEL_TOKEN=

# Your server's public IPv4 — required for WebRTC to work from remote networks
# Leave blank only if you will always access from the same LAN as the server
PUBLIC_IP=
