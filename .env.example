# Required for AI Copilot
ANTHROPIC_API_KEY=sk-ant-...

# Optional data enrichment (free keys)
FRED_API_KEY=           # https://fred.stlouisfed.org/docs/api/api_key.html
BLS_API_KEY=            # https://data.bls.gov/registrationEngine/
EIA_API_KEY=            # https://www.eia.gov/opendata/
TRADIER_SANDBOX_TOKEN=  # https://developer.tradier.com/

# Optional payments (Stripe)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Database (SQLite default, swap for Postgres in production)
DATABASE_URL=sqlite+aiosqlite:///./atlas.db

# Environment
ENVIRONMENT=production

# CORS (comma-separated — leave blank to allow all)
CORS_ORIGINS=
