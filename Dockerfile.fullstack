# Stage 1: Build React frontend
FROM node:20-slim AS frontend-builder

WORKDIR /frontend

COPY atlas/frontend/package*.json ./
RUN npm ci

COPY atlas/frontend/ ./
RUN npm run build

# Stage 2: Python backend + bundled frontend
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc curl && \
    rm -rf /var/lib/apt/lists/*

COPY atlas/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY atlas/backend/ .

# Copy built React app into frontend/dist so FastAPI StaticFiles can serve it
COPY --from=frontend-builder /frontend/dist ./frontend/dist

EXPOSE 8000

# $PORT is set by Render/Railway/Fly; fall back to 8000 for local Docker
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 2
